{
  "name": "checkyollama",
  "displayName": "checkyollama",
  "description": "First-class VS Code support for Ollama Modelfiles — autocomplete, hover docs, and real-time validation.",
  "version": "0.1.1",
  "publisher": "divyeshkamalanaban",
  "icon": "images/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/divyesh-kamalanaban/checkyollama.git"
  },
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vscode-test"
  },
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "title": "checkyollama",
      "properties": {
        "checkyollama.enableDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable real-time Modelfile validation diagnostics."
        },
        "checkyollama.enableAutocomplete": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable autocomplete for instructions and parameters."
        },
        "checkyollama.enableHover": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable hover documentation for parameters."
        }
      }
    },
    "languages": [
      {
        "id": "modelfile",
        "aliases": [
          "Modelfile",
          "modelfile"
        ],
        "extensions": [
          "modelfile",
          "modelfile.*",
          "Modelfile",
          "Modelfile.*",
          "Modelfile-*",
          "Modelfile_*",
          "modelfile-*",
          "modelfile_*"
        ],
        "filenames": [],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "modelfile",
        "scopeName": "source.modelfile",
        "path": "./snippets/modelfile.json"
      }
    ],
    "grammars": [
      {
        "language": "modelfile",
        "scopeName": "source.modelfile",
        "path": "./syntaxes/modelfile.tmLanguage.json"
      }
    ]
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.0.0",
    "chai": "^6.2.2",
    "mocha": "^11.7.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
